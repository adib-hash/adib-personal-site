# TTS narration keys. Local only — used by scripts/tts/generate.mjs.
# Never read by the browser, never set in Vercel: the audio is pre-generated
# and shipped as a static MP3.
#
# Copy to .env.local (gitignored) and fill in whichever you want to trial.

# https://elevenlabs.io/app/settings/api-keys
# Free tier = 10k credits/mo. The full piece is ~22k chars, so free covers the
# BAKE-OFF SAMPLE but not the full run. Free tier also forbids commercial use.
ELEVENLABS_API_KEY=

# https://platform.openai.com/api-keys
# No free tier. Full run costs roughly $0.35.
OPENAI_API_KEY=

# https://aistudio.google.com/apikey  (free, no card)
# NOTE: this is NOT your Google AI Pro subscription — that's a consumer plan and
# grants no API access. This is a separate, free AI Studio key.
GEMINI_API_KEY=

# Google Cloud TTS (Chirp 3 HD) uses OAuth, not an API key:
#   gcloud auth application-default login
#   gcloud services enable texttospeech.googleapis.com
# Free tier = 1M chars/mo, so the full run is free and stays free.
GOOGLE_CLOUD_PROJECT=
